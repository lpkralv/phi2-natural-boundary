GoldbachBoundaries.Phi2HInf.exists_rightZero_of_offLine : GoldbachBoundaries.Paper2.Z1 →
  (∃ ρ ∈ GoldbachBoundaries.NontrivialZeros, ρ.re ≠ 1 / 2) → ∃ ρ ∈ GoldbachBoundaries.NontrivialZeros, 1 / 2 < ρ.re
GoldbachBoundaries.Phi2HInf.Bsup_attained_of_offLine : GoldbachBoundaries.Paper2.Hinf →
  GoldbachBoundaries.Paper2.Z1 →
    (∃ ρ ∈ GoldbachBoundaries.NontrivialZeros, ρ.re ≠ 1 / 2) →
      1 / 2 < GoldbachBoundaries.Paper2.Bsup ∧
        GoldbachBoundaries.Paper2.Bsup < 1 ∧
          {ρ | ρ ∈ GoldbachBoundaries.NontrivialZeros ∧ ρ.re = GoldbachBoundaries.Paper2.Bsup}.Finite ∧
            {ρ | ρ ∈ GoldbachBoundaries.NontrivialZeros ∧ ρ.re = GoldbachBoundaries.Paper2.Bsup}.Nonempty
GoldbachBoundaries.Phi2HInf.collision_twoBsup_iff : ∀
  (p : ↑GoldbachBoundaries.NontrivialZeros × ↑GoldbachBoundaries.NontrivialZeros),
  ↑p.1 + ↑p.2 = 2 * ↑GoldbachBoundaries.Paper2.Bsup ↔
    (↑p.1).re = GoldbachBoundaries.Paper2.Bsup ∧ ↑p.2 = (starRingEnd ℂ) ↑p.1
GoldbachBoundaries.Phi2HInf.collisionTwoBsupEquiv : GoldbachBoundaries.Phi2HInf.collisionIdx
    (2 * ↑GoldbachBoundaries.Paper2.Bsup) ≃
  { ρ // (↑ρ).re = GoldbachBoundaries.Paper2.Bsup }
@GoldbachBoundaries.Phi2HInf.zeroCoef_mul_zeroCoef_conj : ∀ {ρ : ℂ},
  ρ ∈ GoldbachBoundaries.NontrivialZeros →
    GoldbachBoundaries.Phi2Proof.zeroCoef ρ * GoldbachBoundaries.Phi2Proof.zeroCoef ((starRingEnd ℂ) ρ) =
      ↑(↑(GoldbachBoundaries.zetaMult ρ) ^ 2 * ‖Complex.Gamma ρ‖ ^ 2)
GoldbachBoundaries.Phi2HInf.collisionAtom_twoBsup : GoldbachBoundaries.Phi2HInf.collisionAtom
    (2 * ↑GoldbachBoundaries.Paper2.Bsup) =
  ↑(∑' (ρ : { ρ // (↑ρ).re = GoldbachBoundaries.Paper2.Bsup }),
      ↑(GoldbachBoundaries.zetaMult ↑↑ρ) ^ 2 * ‖Complex.Gamma ↑↑ρ‖ ^ 2)
GoldbachBoundaries.Phi2HInf.collisionAtom_twoBsup_pos : {ρ |
      ρ ∈ GoldbachBoundaries.NontrivialZeros ∧ ρ.re = GoldbachBoundaries.Paper2.Bsup}.Finite →
  {ρ | ρ ∈ GoldbachBoundaries.NontrivialZeros ∧ ρ.re = GoldbachBoundaries.Paper2.Bsup}.Nonempty →
    0 <
      ∑' (ρ : { ρ // (↑ρ).re = GoldbachBoundaries.Paper2.Bsup }),
        ↑(GoldbachBoundaries.zetaMult ↑↑ρ) ^ 2 * ‖Complex.Gamma ↑↑ρ‖ ^ 2
