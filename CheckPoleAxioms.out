@GoldbachBoundaries.Phi2HInf.analyticAt_cauchy_of_gap : ∀ {ι : Type} (a p : ι → ℂ),
  (Summable fun i => ‖a i‖) →
    ∀ {z : ℂ} {r d : ℝ},
      0 < r →
        0 < d →
          ∀ (E : Finset ι),
            (∀ w ∈ Metric.ball z r, ∀ i ∉ E, d ≤ ‖w - p i‖) →
              (∀ i ∈ E, p i ≠ z) → AnalyticAt ℂ (fun w => ∑' (i : ι), a i / (w - p i)) z
