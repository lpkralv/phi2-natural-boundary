    GoldbachBoundaries.Paper2.Z2 →
      GoldbachBoundaries.Paper2.Z3 →
        GoldbachBoundaries.Phi2HInf.StirlingStrip →
          GoldbachBoundaries.Phi2HInf.ZetaNoZeroIoo →
            (∃ ρ ∈ GoldbachBoundaries.NontrivialZeros, ρ.re ≠ 1 / 2) →
              (1 / 2 < GoldbachBoundaries.Paper2.Bsup ∧ GoldbachBoundaries.Paper2.Bsup < 1) ∧
                ({ρ | ρ ∈ GoldbachBoundaries.NontrivialZeros ∧ ρ.re = GoldbachBoundaries.Paper2.Bsup}.Finite ∧
                    {ρ | ρ ∈ GoldbachBoundaries.NontrivialZeros ∧ ρ.re = GoldbachBoundaries.Paper2.Bsup}.Nonempty) ∧
                  (GoldbachBoundaries.Phi2HInf.collisionAtom (2 * ↑GoldbachBoundaries.Paper2.Bsup) =
                        ↑(∑' (ρ : { ρ // (↑ρ).re = GoldbachBoundaries.Paper2.Bsup }),
                            ↑(GoldbachBoundaries.zetaMult ↑↑ρ) ^ 2 * ‖Complex.Gamma ↑↑ρ‖ ^ 2) ∧
                      0 < (GoldbachBoundaries.Phi2HInf.collisionAtom (2 * ↑GoldbachBoundaries.Paper2.Bsup)).re ∧
                        (GoldbachBoundaries.Phi2HInf.collisionAtom (2 * ↑GoldbachBoundaries.Paper2.Bsup)).im = 0) ∧
                    GoldbachBoundaries.HasResidue GoldbachBoundaries.Phi2HInf.Phi2cHInf
                        (2 * ↑GoldbachBoundaries.Paper2.Bsup)
                        (GoldbachBoundaries.Phi2HInf.collisionAtom (2 * ↑GoldbachBoundaries.Paper2.Bsup) /
                          Complex.Gamma (2 * ↑GoldbachBoundaries.Paper2.Bsup)) ∧
                      (0 <
                            (GoldbachBoundaries.Phi2HInf.collisionAtom (2 * ↑GoldbachBoundaries.Paper2.Bsup) /
                                Complex.Gamma (2 * ↑GoldbachBoundaries.Paper2.Bsup)).re ∧
                          (GoldbachBoundaries.Phi2HInf.collisionAtom (2 * ↑GoldbachBoundaries.Paper2.Bsup) /
                                Complex.Gamma (2 * ↑GoldbachBoundaries.Paper2.Bsup)).im =
                            0) ∧
                        meromorphicOrderAt GoldbachBoundaries.Phi2HInf.Phi2cHInf (2 * ↑GoldbachBoundaries.Paper2.Bsup) =
                            ↑(-1) ∧
                          ¬AnalyticAt ℂ GoldbachBoundaries.Phi2HInf.Phi2cHInf (2 * ↑GoldbachBoundaries.Paper2.Bsup)
