    GoldbachBoundaries.Phi2HInf.StirlingStrip →
      ∀ {s : ℂ}, 1 < s.re → s ∉ GoldbachBoundaries.phi2Poles → AnalyticAt ℂ GoldbachBoundaries.Phi2HInf.M0 s
